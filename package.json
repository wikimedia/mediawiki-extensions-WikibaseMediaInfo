{
	"name": "wikibase-media-info",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"test": "grunt test && npm run test:unit",
		"test:unit": "qunit \"tests/node-qunit/**/*.test.js\"",
		"coverage": "c8 --include=\"resources/**/*.js\" --reporter=lcov --reporter=lcovonly --reporter=text --reporter=text-summary qunit \"tests/node-qunit/**/*.test.js\"",
		"install": "rm -rf node_modules/mediawiki && git clone -q --depth=1 --filter=blob:none --sparse https://gerrit.wikimedia.org/r/mediawiki/core node_modules/mediawiki && git -C node_modules/mediawiki sparse-checkout set resources/src"
	},
	"devDependencies": {
		"c8": "12.0.0",
		"eslint-config-wikimedia": "0.32.6",
		"grunt": "1.6.3",
		"grunt-banana-checker": "0.13.0",
		"grunt-eslint": "24.3.0",
		"grunt-stylelint": "0.21.0",
		"jquery": "3.7.1",
		"jquery.uls": "^0.1.0",
		"jsdom": "30.0.1",
		"mustache": "3.0.1",
		"oojs": "7.0.1",
		"oojs-ui": "0.54.1",
		"qunit": "2.26.0",
		"sinon": "7.2.7",
		"stylelint-config-wikimedia": "0.19.4",
		"wikibase-data-model": "^6.1.0",
		"wikibase-data-values": "^0.10.0",
		"wikibase-serialization": "^5.0.0"
	},
	"overrides": {
		"wikibase-serialization": {
			"wikibase-data-model": "$wikibase-data-model"
		}
	}
}
